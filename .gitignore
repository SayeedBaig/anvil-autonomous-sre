# SENTINEL_ONE — Root .gitignore
# ─────────────────────────────

# ── Secrets / Env ──
.env
.env.local
.env.production
.env.*.local
*.pem
*.key

# ── Python ──
__pycache__/
*.py[cod]
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
htmlcov/
.coverage
*.db
*.sqlite

# ── Node / Next.js ──
node_modules/
.next/
out/
dist/
build/

# ── Docker ──
*.tar

# ── IDE / OS ──
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ── GCP ──
gcloud-service-key.json
service-account-key.json
